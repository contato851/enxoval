# Copie para .env.local e preencha. Nunca versione o .env.local.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable "sb_publishable_..." ou a antiga "anon"). Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (secret "sb_secret_..." ou a antiga "service_role"). SÓ no servidor.
# Usada apenas para excluir a conta do usuário no Auth.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do app (usado no link do email e nos convites).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Emails autorizados a entrar, separados por vírgula.
# Apague a variável (ou deixe vazia) para abrir o cadastro a qualquer pessoa.
ALLOWED_EMAILS=voce@exemplo.com,parceiro@exemplo.com

# Opcional, só para rodar os testes de RLS (Postgres com superusuário).
# RLS_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
